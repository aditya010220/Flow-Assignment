NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/flowlens?sslmode=require
R2_ACCOUNT_ID=sample_r2_account_id
R2_ACCESS_KEY_ID=sample_r2_access_key
R2_SECRET_ACCESS_KEY=sample_r2_secret_key
R2_BUCKET_NAME=flowlens-evidence
