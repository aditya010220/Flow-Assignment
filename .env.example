# FlowLens Environment Configuration Template
NODE_ENV=development

# Express Backend
PORT=5000
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/flowlens?sslmode=require

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=sample_r2_account_id
R2_ACCESS_KEY_ID=sample_r2_access_key
R2_SECRET_ACCESS_KEY=sample_r2_secret_key
R2_BUCKET_NAME=flowlens-evidence
R2_ENDPOINT=https://sample_r2_account_id.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=

# Dockerized Worker Communication
WORKER_INTERNAL_URL=http://localhost:4000
WORKER_CALLBACK_SECRET=flowlens-internal-worker-secret
SCAN_MAX_PAGES=5
SCAN_TIMEOUT_MS=180000

# Frontend Next.js Public
NEXT_PUBLIC_API_URL=http://localhost:5000/api
